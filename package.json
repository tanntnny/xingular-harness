{
  "name": "@xingular/harness",
  "version": "4.0.0",
  "type": "module",
  "description": "Xingular Harness — a Pi agent harness built on recursive harnessing (Harness²): versioned eight-component harness trees, refinement from evidence, multi-account sessions, a compiled prompt, project notes, tools, and MCP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanntnny/xingular-harness.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "bin": {
    "xharness": "dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:tui",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/cli.js && esbuild src/terminal/piExtension.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/terminal-pi.js",
    "build:tui": "node scripts/build-opentui.mjs",
    "dev": "npm run build && node scripts/dev.mjs",
    "prepack": "npm run build",
    "ci": "bash scripts/ci.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "profile:terminal-input": "node scripts/profile-terminal-input.mjs",
    "profile:terminal-latency": "python3 scripts/profile-terminal-latency.py",
    "prove": "npm run build && node scripts/prove-standalone.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "solid-js": "^1.9.12",
    "typebox": "^1.3.7",
    "yaml": "^2.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "src",
    "dist",
    "builtin",
    "README.md",
    "NOTICE.md",
    "CHANGELOG.md",
    "docs",
    "!docs/evidence/**"
  ]
}
